# Copy to .env and fill in. Never commit real secrets.

# --- Database (MongoDB Atlas or self-hosted) ---
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/car_portal?retryWrites=true&w=majority
# Optional: use these resolvers if the machine's DNS refuses mongodb+srv SRV lookups (querySrv ECONNREFUSED).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Authentication ---
# Public URL of this portal. Use https:// in production (enables secure cookies).
NEXTAUTH_URL=http://localhost:3001
# Long random string, e.g. `openssl rand -base64 48`. Also used to seal customer conversation links.
NEXTAUTH_SECRET=
# First admin, created on the first sign-in while no staff accounts exist. Remove the password afterwards.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Customer website (car-web) ---
# Comma-separated origins allowed to call /api/public/* from the browser.
CLIENT_ORIGINS=http://localhost:3000
# Base URL used in customer-facing links (e.g. conversation threads).
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# --- Image uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=motive/vehicles
# Customer sell / swap photos (uploaded from the website via /api/public/uploads) go to `${CLOUDINARY_FOLDER}/trade-ins`.

# --- Email (Resend). FROM_EMAIL must be on a domain verified in Resend. ---
RESEND_API_KEY=
FROM_EMAIL="Motive Motor Collection <no-reply@your-domain.com>"
# Where new-enquiry alerts go (falls back to the dealership email in Settings).
NOTIFY_EMAIL=

# --- SMS / WhatsApp (Twilio, optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Staff mobile number that receives SMS alerts for new enquiries (E.164, e.g. +260970000000).
ADMIN_PHONE=

# --- Misc ---
# Source for "Refresh live rates" in Settings. Called as `${EXCHANGE_RATES_URL}/${BASE}` and must return { rates: { CODE: number } }.
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest
TZ=Africa/Lusaka
